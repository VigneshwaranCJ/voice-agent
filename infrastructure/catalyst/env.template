# Environment variables for Zoho Catalyst AppSail. Paste each line into
#   Catalyst console > your project > AppSail > (service) > Configuration > Environment Variables
# (key = text before "=", value = text after). build-catalyst.ps1 generated JWT_SECRET and ENCRYPTION_KEY.
# Keep this file private. Lines starting with # are notes, not variables.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Supabase > Project Settings > Database > Connection string > "Session pooler" (port 5432, IPv4).
# Paste it as given (postgresql://...); replace [YOUR-PASSWORD] and add ?sslmode=require at the end.
# Don't use the "Transaction pooler" (port 6543): it breaks the asyncpg driver.
DATABASE_URL=
# AppSail may run up to 5 copies; keep each one's pool small so Supabase's connection limit isn't hit.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Optional but recommended: Redis shared by all copies (live chat/call state, e.g. Upstash, rediss://...).
REDIS_URL=

SARVAM_API_KEY=
# Voice calls: hosted Sarvam Voice Agents (docs/deploy/SARVAM_VOICE.md). AppSail can't carry a browser WebSocket,
# so browsers talk to Sarvam directly; this key only signs each call on the server.
SARVAM_AGENTS_API_KEY=
SARVAM_AGENTS_ORG_ID=
SARVAM_AGENTS_WORKSPACE_ID=
SARVAM_AGENTS_APP_ID=
SARVAM_AGENTS_SEND_CONTEXT=false

# Security (generated)
JWT_SECRET=__GENERATED__
JWT_EXPIRE_MINUTES=480
ENCRYPTION_KEY=__GENERATED__
RATE_LIMIT_PER_MINUTE=120

# Your public dashboard address(es), JSON list. Start with the AppSail URL; add https://app.kuralai.com once mapped.
CORS_ORIGINS=["https://YOUR-APPSAIL-URL"]
PUBLIC_BASE_URL=https://YOUR-APPSAIL-URL
SEED_DEMO_DATA=false

# Platform admins, created on start if they don't exist yet (12+ character passwords). Remove passwords after
# first sign-in. More admins: BOOTSTRAP_ADMIN_EMAIL_2 / BOOTSTRAP_ADMIN_PASSWORD_2 ... up to _10.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email alerts (optional). Zoho Mail: smtp.zoho.in, 587, starttls, app-specific password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
