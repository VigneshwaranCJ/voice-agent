# ---- Copy to .env and fill in. Never commit .env. ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sarvam AI (https://dashboard.sarvam.ai) — required for AI replies in text chat and the website widget
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_REASONING_EFFORT=low
# ---- Voice: hosted Sarvam Voice Agents (see docs/deploy/SARVAM_VOICE.md) ----
# Voice Agents API key (indus.sarvam.ai > Samvaad > Settings > API key). Separate from SARVAM_API_KEY above.
# Server-side only: it signs each call; the browser then talks to Sarvam directly (works without WebSockets here).
SARVAM_AGENTS_API_KEY=
# Defaults used when an agent's Sarvam link leaves a field blank (a link's own value wins). Org and workspace are
# shown on indus.sarvam.ai > Deploy with Code; the app id is the agent's "Copy agent ID".
SARVAM_AGENTS_ORG_ID=
SARVAM_AGENTS_WORKSPACE_ID=
SARVAM_AGENTS_APP_ID=
# Send business name/persona/phone/hours/services as agent_variables at call start. Declare these variables in
# the Sarvam agent first: business_name, business_phone, business_hours, business_services, persona_name, languages.
SARVAM_AGENTS_SEND_CONTEXT=false

# Database: SQLite works for local dev; docker-compose uses PostgreSQL (pgvector image)
DATABASE_URL=sqlite+aiosqlite:///./voicecare.db
# DATABASE_URL=postgresql+asyncpg://voicecare:voicecare@localhost:5432/voicecare
# Optional: Redis for live conversation state (in-process store if unset)
REDIS_URL=

# Security — generate real values outside development:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_SECRET=dev-only-change-me
ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=120

# Development seed data (two fictional demo businesses). Accounts created on first start:
#   platform admin : SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD
#   Sunrise Realty : admin@sunrise.local  / SEED_TENANT_PASSWORD
#   CareWell Hosp. : admin@carewell.local / SEED_TENANT_PASSWORD
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@platform.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
SEED_TENANT_PASSWORD=ChangeMe-Tenant-123

# Email alerts to each business's admins (new leads, handoffs). Off while SMTP_HOST is empty.
# Zoho Mail: SMTP_HOST=smtp.zoho.in, SMTP_PORT=587, SMTP_SECURITY=starttls, app-specific password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=
